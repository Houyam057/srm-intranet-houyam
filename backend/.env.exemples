BACKEND_URL=http://localhost:8069

# Le chatbot IA (module chatbot_ai) ne lit pas de variables d'environnement :
# sa config vit dans les Parametres Systeme d'Odoo (Reglages > Technique > Parametres Systeme) :
#   chatbot.ai_api_key    (obligatoire, pas de valeur par defaut)
#   chatbot.ai_base_url   (defaut: https://api.groq.com/openai/v1)
#   chatbot.ai_model      (defaut: llama-3.1-8b-instant)