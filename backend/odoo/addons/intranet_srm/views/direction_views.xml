<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Direction Old List View -->
        <record id="direction_old_list_view" model="ir.ui.view">
            <field name="name">Direction Old List</field>
            <field name="model">intranet.direction_old</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <!-- Direction Old Form View -->
        <record id="direction_old_form_view" model="ir.ui.view">
            <field name="name">Direction Old Form</field>
            <field name="model">intranet.direction_old</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <field name="code"/>
                        </group>
                        <field name="description"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Direction Old Action -->
        <record id="direction_old_action" model="ir.actions.act_window">
            <field name="name">Directions (ancien)</field>
            <field name="res_model">intranet.direction_old</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_direction_old" name="Directions (ancien)" action="direction_old_action" parent="menu_intranet_config"/>
    </data>
</odoo>
