<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- User List View -->
        <record id="user_list_view" model="ir.ui.view">
            <field name="name">User List</field>
            <field name="model">intranet.user</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="role"/>
                    <field name="direction_id"/>
                    <field name="job_title"/>
                </list>
            </field>
        </record>

        <!-- User Form View -->
        <record id="user_form_view" model="ir.ui.view">
            <field name="name">User Form</field>
            <field name="model">intranet.user</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="login"/>
                                <field name="role"/>
                            </group>
                            <group>
                                <field name="direction_id"/>
                                <field name="job_title"/>
                                <field name="is_manager"/>
                                <field name="avatar_url"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- User Action -->
        <record id="user_action" model="ir.actions.act_window">
            <field name="name">Utilisateurs</field>
            <field name="res_model">intranet.user</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_user" name="Utilisateurs" action="user_action" parent="menu_intranet_main"/>
    </data>
</odoo>
