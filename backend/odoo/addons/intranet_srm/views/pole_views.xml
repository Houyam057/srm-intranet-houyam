<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pole_view_tree" model="ir.ui.view">
        <field name="name">intranet.pole.tree</field>
        <field name="model">intranet.pole</field>
        <field name="arch" type="xml">
            <list string="Pôles">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="pole_view_form" model="ir.ui.view">
        <field name="name">intranet.pole.form</field>
        <field name="model">intranet.pole</field>
        <field name="arch" type="xml">
            <form string="Pôle">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Directions">
                            <field name="direction_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pole_action" model="ir.actions.act_window">
        <field name="name">Pôles</field>
        <field name="res_model">intranet.pole</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="pole_menu"
              name="Pôles"
              parent="menu_intranet_config"
              action="pole_action"
              sequence="20"/>
</odoo>
