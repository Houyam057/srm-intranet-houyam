<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Direction New List View -->
        <record id="direction_new_list_view" model="ir.ui.view">
            <field name="name">Direction New List</field>
            <field name="model">intranet.direction</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="manager_name"/>
                    <field name="pole_id"/>
                    <field name="sub_direction_count"/>
                </list>
            </field>
        </record>

        <!-- Direction New Form View -->
        <record id="direction_new_form_view" model="ir.ui.view">
            <field name="name">Direction New Form</field>
            <field name="model">intranet.direction</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <group>
                                <field name="manager_id"/>
                                <field name="pole_id"/>
                            </group>
                            <group>
                                <field name="sub_direction_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description"/>
                        <field name="sub_direction_ids"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Direction New Action -->
        <record id="direction_new_action" model="ir.actions.act_window">
            <field name="name">Directions</field>
            <field name="res_model">intranet.direction</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_direction_new" name="Directions" action="direction_new_action" parent="menu_intranet_main"/>
    </data>
</odoo>
