<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Direction P List View -->
        <record id="direction_p_list_view" model="ir.ui.view">
            <field name="name">Direction Principale List</field>
            <field name="model">intranet.direction_p</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="manager_name"/>
                    <field name="pole_name"/>
                    <field name="direction_count"/>
                </list>
            </field>
        </record>

        <!-- Direction P Form View -->
        <record id="direction_p_form_view" model="ir.ui.view">
            <field name="name">Direction Principale Form</field>
            <field name="model">intranet.direction_p</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="manager_id"/>
                                <field name="pole_id"/>
                            </group>
                            <group>
                                <field name="direction_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description"/>
                        <field name="direction_ids"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Direction P Action -->
        <record id="direction_p_action" model="ir.actions.act_window">
            <field name="name">Directions Principales</field>
            <field name="res_model">intranet.direction_p</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_direction_p" name="Directions Principales" action="direction_p_action" parent="menu_intranet_main"/>
    </data>
</odoo>
