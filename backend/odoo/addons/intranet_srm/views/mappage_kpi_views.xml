<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mappage_kpi_list_view" model="ir.ui.view">
            <field name="name">Mappage KPI List</field>
            <field name="model">intranet.mappage_kpi</field>
            <field name="arch" type="xml">
                <list>
                    <field name="direction_name"/>
                    <field name="kpi_name"/>
                </list>
            </field>
        </record>

        <record id="mappage_kpi_form_view" model="ir.ui.view">
            <field name="name">Mappage KPI Form</field>
            <field name="model">intranet.mappage_kpi</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="direction_id"/>
                            </group>
                            <group>
                                <field name="kpi_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mappage_kpi_action" model="ir.actions.act_window">
            <field name="name">Mappage KPIs</field>
            <field name="res_model">intranet.mappage_kpi</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_mappage_kpi" name="Affectation KPIs / Directions" action="mappage_kpi_action" parent="menu_intranet_main"/>
    </data>
</odoo>
