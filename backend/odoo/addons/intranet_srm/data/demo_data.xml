<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- POLES -->
        <record id="pole_dg" model="intranet.pole">
            <field name="name">Direction Générale</field>
            <field name="description">Pôle de la Direction Générale</field>
        </record>

        <record id="pole_exploitations" model="intranet.pole">
            <field name="name">Pôle Exploitations</field>
            <field name="description">Pôle des exploitations</field>
        </record>

        <record id="pole_support" model="intranet.pole">
            <field name="name">Pôle Fonctions Support</field>
            <field name="description">Pôle des fonctions de support</field>
        </record>

        <!-- DIRECTIONS -->
        <record id="dir_dg" model="intranet.direction">
            <field name="name">Direction Générale</field>
            <field name="code">DG</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_qse" model="intranet.direction">
            <field name="name">Développement et Suivi des Performances, QSE</field>
            <field name="code">QSE</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_communication" model="intranet.direction">
            <field name="name">Communication Externe et Marketing</field>
            <field name="code">COMM</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_controle" model="intranet.direction">
            <field name="name">Contrôle Permanent</field>
            <field name="code">CTRL</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_audit" model="intranet.direction">
            <field name="name">Audit Interne</field>
            <field name="code">AUDIT</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_gouvernance" model="intranet.direction">
            <field name="name">Gouvernance, Gestion des Contrats et Relations Institutionnelles</field>
            <field name="code">GOV</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_invest" model="intranet.direction">
            <field name="name">Direction des Investissements</field>
            <field name="code">INVEST</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_clientele" model="intranet.direction">
            <field name="name">Direction Clientèle</field>
            <field name="code">CLI</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_rh" model="intranet.direction">
            <field name="name">Direction du Capital Humain</field>
            <field name="code">RH</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_houceima" model="intranet.direction">
            <field name="name">Direction Province Al Hoceima</field>
            <field name="code">PROV-HOU</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_tetouan" model="intranet.direction">
            <field name="name">Direction Province Tétouan</field>
            <field name="code">PROV-TET</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_larache" model="intranet.direction">
            <field name="name">Direction Province Larache</field>
            <field name="code">PROV-LAR</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_chefchaouen" model="intranet.direction">
            <field name="name">Direction Province Chefchaouen</field>
            <field name="code">PROV-CHE</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_ouazzane" model="intranet.direction">
            <field name="name">Direction Province Ouazzane</field>
            <field name="code">PROV-OUA</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_fahs" model="intranet.direction">
            <field name="name">Direction Province Fahs-Anjra</field>
            <field name="code">PROV-FAH</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <record id="dir_mdiq" model="intranet.direction">
            <field name="name">Direction Province M'diq-Fnideq</field>
            <field name="code">PROV-MDI</field>
            <field name="pole_id" ref="pole_dg"/>
        </record>

        <!-- NEWS -->
        <record id="news_1" model="intranet.news">
            <field name="title">Bienvenue sur l'Intranet SRM-TTA</field>
            <field name="summary">Découvrez la plateforme collaborative de SRM-TTA</field>
            <field name="content">&lt;p&gt;Bienvenue sur le nouvel intranet de SRM-TTA! Cette plateforme est conçue pour faciliter la communication et la collaboration entre tous les employés.&lt;/p&gt;</field>
            <field name="priority">high</field>
            <field name="category">Actualité</field>
            <field name="published">True</field>
        </record>

        <record id="news_2" model="intranet.news">
            <field name="title">Nouvelle politique de télétravail</field>
            <field name="summary">Retrouvez les détails de la nouvelle politique</field>
            <field name="content">&lt;p&gt;La direction a approuvé une nouvelle politique de télétravail. Consultez les détails dans la section Ressources Humaines.&lt;/p&gt;</field>
            <field name="priority">medium</field>
            <field name="category">RH</field>
            <field name="published">True</field>
        </record>

        <record id="news_3" model="intranet.news">
            <field name="title">Réunion trimestrielle - Juin 2026</field>
            <field name="summary">Préparez-vous pour la réunion de juin</field>
            <field name="content">&lt;p&gt;La réunion trimestrielle aura lieu le 15 juin 2026. Les détails de l'agenda seront partagés prochainement.&lt;/p&gt;</field>
            <field name="priority">high</field>
            <field name="category">Réunion</field>
            <field name="published">True</field>
        </record>

        <!-- KPIS -->
        <record id="kpi_clients_satisfaits" model="intranet.kpi">
            <field name="name">Clients satisfaits</field>
            <field name="val">87.0</field>
        </record>

        <record id="kpi_taux_recouvrement" model="intranet.kpi">
            <field name="name">Taux de recouvrement</field>
            <field name="val">99.2</field>
        </record>

        <record id="kpi_reclamations_traitees" model="intranet.kpi">
            <field name="name">Réclamations traitées</field>
            <field name="val">96.0</field>
        </record>

        <record id="mappage_kpi_clientele" model="intranet.mappage_kpi">
            <field name="direction_id" ref="dir_clientele"/>
            <field name="kpi_id" ref="kpi_clients_satisfaits"/>
        </record>
    </data>
</odoo>
