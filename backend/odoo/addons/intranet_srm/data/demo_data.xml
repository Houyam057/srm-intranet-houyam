<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- DIRECTIONS PRINCIPALES (anciennement "poles") -->
        <record id="direction_p_dg" model="intranet.direction_p">
            <field name="name">Direction Générale</field>
            <field name="description">Direction Principale : Direction Générale</field>
        </record>

        <record id="direction_p_exploitations" model="intranet.direction_p">
            <field name="name">Pôle Exploitations</field>
            <field name="description">Direction Principale : exploitations</field>
        </record>

        <record id="direction_p_support" model="intranet.direction_p">
            <field name="name">Pôle Fonctions Support</field>
            <field name="description">Direction Principale : fonctions de support</field>
        </record>

        <!-- DIRECTIONS -->
        <record id="direction_dg" model="intranet.direction">
            <field name="name">Direction Générale</field>
            <field name="direction_p_id" ref="direction_p_dg"/>
            <field name="description">Direction Générale de SRM-TTA</field>
        </record>

        <record id="direction_exploit" model="intranet.direction">
            <field name="name">Direction en charge des Exploitations</field>
            <field name="direction_p_id" ref="direction_p_dg"/>
            <field name="description">Direction responsable des exploitations</field>
        </record>

        <record id="direction_eau" model="intranet.direction">
            <field name="name">Direction Exploitation Eau Potable</field>
            <field name="direction_p_id" ref="direction_p_exploitations"/>
            <field name="description">Gestion de l'eau potable</field>
        </record>

        <record id="direction_assain" model="intranet.direction">
            <field name="name">Direction Exploitation Assainissement Liquide</field>
            <field name="direction_p_id" ref="direction_p_exploitations"/>
            <field name="description">Gestion de l'assainissement</field>
        </record>

        <record id="direction_elec" model="intranet.direction">
            <field name="name">Direction Exploitation Électricité</field>
            <field name="direction_p_id" ref="direction_p_exploitations"/>
            <field name="description">Gestion de l'électricité</field>
        </record>

        <record id="direction_rh" model="intranet.direction">
            <field name="name">Direction du Capital Humain</field>
            <field name="direction_p_id" ref="direction_p_support"/>
            <field name="description">Gestion des ressources humaines</field>
        </record>

        <!-- NEWS -->
        <record id="news_1" model="intranet.news">
            <field name="title">Bienvenue sur l'Intranet SRM-TTA</field>
            <field name="summary">Découvrez la plateforme collaborative de SRM-TTA</field>
            <field name="content">&lt;p&gt;Bienvenue sur le nouvel intranet de SRM-TTA! Cette plateforme est conçue pour faciliter la communication et la collaboration entre tous les employés.&lt;/p&gt;</field>
            <field name="priority">high</field>
            <field name="category">Actualité</field>
            <field name="published">True</field>
        </record>

        <record id="news_2" model="intranet.news">
            <field name="title">Nouvelle politique de télétravail</field>
            <field name="summary">Retrouvez les détails de la nouvelle politique</field>
            <field name="content">&lt;p&gt;La direction a approuvé une nouvelle politique de télétravail. Consultez les détails dans la section Ressources Humaines.&lt;/p&gt;</field>
            <field name="priority">medium</field>
            <field name="category">RH</field>
            <field name="published">True</field>
        </record>

        <record id="news_3" model="intranet.news">
            <field name="title">Réunion trimestrielle - Juin 2026</field>
            <field name="summary">Préparez-vous pour la réunion de juin</field>
            <field name="content">&lt;p&gt;La réunion trimestrielle aura lieu le 15 juin 2026. Les détails de l'agenda seront partagés prochainement.&lt;/p&gt;</field>
            <field name="priority">high</field>
            <field name="category">Réunion</field>
            <field name="published">True</field>
        </record>
    </data>
</odoo>
