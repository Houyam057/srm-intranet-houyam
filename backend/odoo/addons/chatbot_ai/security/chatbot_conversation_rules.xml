<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sans cette regle, ir.model.access.csv donne un acces perm_read/perm_write
             a tout base.group_user sur TOUTES les conversations : n'importe quel
             employe pourrait lire celles des autres via l'ORM/RPC standard d'Odoo
             (le controleur ne verifie l'appartenance que pour ses propres routes HTTP). -->
        <record id="chatbot_conversation_own_only" model="ir.rule">
            <field name="name">Conversation Chatbot : uniquement les siennes</field>
            <field name="model_id" ref="model_chatbot_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
